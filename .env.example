# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# CI 环境请改用 GitHub Actions Secrets 注入同名环境变量。

# Wiki 登录用户名（主账号名，不带 @BotName 后缀）
PTILOPSIS_USERNAME=BotPtilopsis

# Wiki 登录密码。请使用 Special:BotPasswords 生成的机器人密码，
# 格式为 <BotName>@<32位随机串>，不要直接使用主账号密码。
PTILOPSIS_PASSWORD=

# Sentry DSN，留空则不启用错误上报
PTILOPSIS_SENTRY_DSN=

# 可选：本地限速相对服务器配额的比例 (0, 1]，任意一个配额窗口内至多发出「配额×该值」次写请求，越小越保守，默认 0.8
# PTILOPSIS_RATE_SAFETY=0.8

# 可选：两次写请求的最小间隔秒数，默认 0 不限制；服务器限流严于预期时可调大
# PTILOPSIS_WRITE_MIN_INTERVAL=0

# 可选：指定 config.json 路径，默认取工作目录 / 仓库根目录下的 config.json
# PTILOPSIS_CONFIG_PATH=config.json
